{
  "name": "math-7th",
  "version": "0.1.0",
  "private": true,
  "description": "MATH 7TH — منصة رياضيات تفاعلية للصف السابع (المنهاج السوري)",
  "scripts": {
    "predev": "node scripts/clean-stale-types.mjs",
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/preview-static.mjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "guard": "node scripts/guard.mjs",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:stats": "tsx scripts/content-stats.ts",
    "check": "npm run guard && npm run admin:config:check && npm run typecheck && npm run test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "media:import": "tsx scripts/media-import.ts",
    "media:sync": "tsx scripts/media-sync.ts",
    "admin:config": "tsx scripts/admin-config.ts",
    "admin:config:check": "tsx scripts/admin-config.ts --check",
    "admin:verify-github": "tsx scripts/admin-verify-github.ts"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@sveltia/cms": "0.262.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.17.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.8.1"
  }
}
