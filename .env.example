# ── MATH 7TH — environment variables ─────────────────────────────────────────
# Copy to `.env` and fill in. Never commit real values.

# Secret used to sign the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Bootstrap credentials for the single owner account, used by `npm run db:seed-admin`.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=

# ── AI quiz generation (server-side only, never exposed to the browser) ──────
# Leave QUIZ_PROVIDER unset and the platform still works fully: lessons, images
# and browsing are unaffected, quizzes simply report "generation unavailable".
#
# The provider speaks the OpenAI-compatible /chat/completions contract, so the
# same variables work with OpenAI, Groq, OpenRouter, Together, or a local server.
QUIZ_PROVIDER=
QUIZ_API_BASE_URL=https://api.openai.com/v1
QUIZ_API_KEY=
QUIZ_MODEL=
# Optional: a vision-capable model for reading the lesson page images.
QUIZ_VISION_MODEL=

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=15728640

# ── Presentation ─────────────────────────────────────────────────────────────
TIME_ZONE=Asia/Damascus
